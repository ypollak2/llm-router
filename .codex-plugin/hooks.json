{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/session-start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/auto-route.py"
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/status-bar.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/enforce-route.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/agent-route.py"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/subagent-start.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/usage-refresh.py"
          }
        ],
        "matcher": "llm_|mcp__llm_router__llm"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/cc-usage-track.py"
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/agent-depth-release.py"
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/playwright-compress.py"
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/bash-compress.py"
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/context-capture.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/hooks/session-end.py"
          }
        ]
      }
    ]
  }
}
